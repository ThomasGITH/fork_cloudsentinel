map $http_upgrade $cloudsentinel_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 16.16.28.122;

    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
        auth_basic off;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name 16.16.28.122;

    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/16.16.28.122/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/16.16.28.122/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "CloudSentinel usability session";
    auth_basic_user_file /etc/nginx/cloudsentinel.htpasswd;

    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cloudsentinel_connection_upgrade;

        # The current application does not use HTTP Authorization. Do not pass
        # the participant's proxy credential into Django or cluster services.
        proxy_set_header Authorization "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
