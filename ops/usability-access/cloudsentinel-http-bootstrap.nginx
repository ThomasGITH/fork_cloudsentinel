server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 16.16.28.122;

    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
        auth_basic off;
    }

    location / {
        return 404;
    }
}
